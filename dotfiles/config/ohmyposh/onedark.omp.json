{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "blue": "#4FA6ED",
    "green": "#89B96A",
    "yellow": "#E5C07B",
    "red": "#E06C75",
    "purple": "#B07DD8",
    "cyan": "#56B6C2",
    "gray": "#5C6370",
    "fg": "#ABB2BF",
    "bright": "#D7DAE0"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:gray",
          "template": "󰀵 "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ .UserName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:gray",
          "template": "  "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:bright",
          "template": "󰉋 {{ .Path }}",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": " › ",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:blue",
          "template": "   {{ .HEAD }}{{ if .Working.Changed }}*{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:green",
          "template": " {{ .Full }}  "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": " {{ .Full }}  "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:cyan",
          "template": " {{ .Full }}  "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:red",
          "template": " {{ .Full }}  "
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "p:red",
          "template": " {{ .Full }}  "
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "p:cyan",
          "template": " {{ .Context }}  "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "󰔟 {{ .FormattedMs }}  ",
          "properties": {
            "threshold": 2000
          }
        },
        {
          "type": "sysinfo",
          "style": "plain",
          "foreground": "p:purple",
          "template": "󰍛 {{ printf \"%.1f\" (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }} GB",
          "properties": {
            "cache_duration": "5s"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}",
            "{{ if eq .Code 0 }}p:blue{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ]
}

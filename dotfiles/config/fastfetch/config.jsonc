{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " │ "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "󰀵 OS"
    },
    {
      "type": "host",
      "key": "󰒋 Host"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    "break",
    {
      "type": "shell",
      "key": "󱆃 Shell"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    {
      "type": "command",
      "key": "󰖳 Theme",
      "text": "Gruvbox Material Dark Medium"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    "break",
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },
    {
      "type": "battery",
      "key": "󰂄 Battery"
    }
  ]
}
